{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["package", "channel"],
  "properties": {
    "package": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string",
          "oneOf": [
            { "enum": ["MIT", "Apache-2.0", "GPL-3.0"] },
            { "format": "uri", "pattern": "^https?://.*$" }
          ]
        },
        "icon": {
          "type": "string",
          "default": "icon.svg"
        }
      }
    },
    "channel": {
      "type": "object",
      "patternProperties": {
        "^[a-z-]+$": {
          "$ref": "#/definitions/channel"
        }
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "apt": {
          "$ref": "#/definitions/apt-repo"
        }
      }
    }
  },
  "definitions": {
    "channel": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "properties": {
            "aur": {
              "type": "object",
              "required": ["package"],
              "properties": {
                "package": {
                  "type": "string"
                }
              }
            },
            "alpine": {
              "type": "object",
              "required": ["package"],
              "properties": {
                "package": {
                  "type": "string"
                }
              }
            },
            "apt": {
              "type": "object",
              "required": ["package"],
              "properties": {
                "package": {
                  "type": "string"
                },
                "signing_key": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://.*$"
                },
                "repository": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "apt-repo": {
      "oneOf": [
        {
          "type": "object",
          "required": ["format"],
          "properties": {
            "format": {
              "type": "string",
              "const": "deb822"
            },
            "source": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["types", "uris", "suites", "arch"],
                "properties": {
                  "types": {
                    "type": "string",
                    "enum": ["deb", "deb-src"]
                  },
                  "uris": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "suites": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "arch": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            },
            "signing_key": {
              "type": "string",
              "oneOf": [
                { "format": "uri", "pattern": "^https?://.*$" },
                {
                  "pattern": "^[a-zA-Z0-9_-]+\\.pub$"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
